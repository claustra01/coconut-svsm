+/* Experimental local SVSM protocol: drain TCP observations into one page. */
+int snp_socktrawl_read(u8 *buffer, size_t capacity)
+{
+	struct svsm_call call = {};
+	unsigned long flags;
+	int ret;
+
+	if (!snp_vmpl)
+		return -ENODEV;
+	if (!capacity || capacity > PAGE_SIZE || !IS_ALIGNED((unsigned long)buffer, PAGE_SIZE))
+		return -EINVAL;
+
+	local_irq_save(flags);
+	call.caa = svsm_get_caa();
+	call.rax = 0x80000054ULL << 32;
+	call.rcx = __pa(buffer);
+	call.rdx = capacity;
+	ret = svsm_perform_call_protocol(&call);
+	local_irq_restore(flags);
+	if (ret)
+		return ret;
+	if (call.rcx_out > capacity || call.rcx_out % 56)
+		return -EIO;
+	return call.rcx_out;
+}
+EXPORT_SYMBOL_GPL(snp_socktrawl_read);
